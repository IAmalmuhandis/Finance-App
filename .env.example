# MongoDB (local Docker or Atlas)
DATABASE_URL="mongodb://localhost:27017/arzo"
# Optional: non-SRV direct URI if SRV resolution fails (Windows)
# MONGODB_DIRECT_URI="mongodb://user:pass@host1:27017,host2:27017/arzo?tls=true"

# NextAuth — set NEXTAUTH_URL to your public origin in production (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# Google OAuth (optional — enables “Continue with Google” on sign-in)
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
