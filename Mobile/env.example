# Copy to .env in this folder. Restart Expo after changes (use --clear once).
#
# Hosted server: same origin as your deployed Next app (https, no trailing slash).
# EXPO_PUBLIC_API_BASE_URL=https://your-app.onrender.com
#
# Local dev: same Wi‑Fi as the phone, your PC's LAN IP — not localhost from the phone.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000

# Google sign-in — same Web client ID as the Next.js server.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
#
# Google Cloud → Web OAuth client → Authorized redirect URIs:
#   https://auth.expo.io/@anonymous/arzo
# EXPO_PUBLIC_EXPO_AUTH_PROXY_PATH=@anonymous/arzo
#
# Server must have NEXTAUTH_SECRET and GOOGLE_CLIENT_ID for mobile Google sign-in.
